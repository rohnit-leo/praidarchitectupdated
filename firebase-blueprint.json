{
  "entities": {
    "projects": {
      "title": "Portfolio Projects",
      "description": "Architectural and design projects managed by PRIAD Architects",
      "fields": {
        "id": { "type": "string", "description": "Unique identifier for the project" },
        "title": { "type": "string", "description": "Project title" },
        "subtitle": { "type": "string", "description": "Subtitle or tagline" },
        "category": { "type": "string", "description": "Architecture / Interior / etc." },
        "location": { "type": "string", "description": "Project geographical location" },
        "areaSqFt": { "type": "number", "description": "Total square footage" },
        "year": { "type": "number", "description": "Year completed" },
        "status": { "type": "string", "description": "Completed / Under Construction / Concept" },
        "heroImage": { "type": "string", "description": "Hero cover image URL or direct upload data" },
        "galleryImages": { "type": "array", "description": "Gallery images list" },
        "beforeImage": { "type": "string", "description": "Before image for renovation" },
        "afterImage": { "type": "string", "description": "After image for renovation" },
        "blueprintImage": { "type": "string", "description": "Architectural blueprint or floor plan image" },
        "conceptDescription": { "type": "string", "description": "In-depth concept design description" },
        "keyMaterials": { "type": "array", "description": "List of key architectural materials" },
        "architecturalStyle": { "type": "string", "description": "Architectural style" },
        "structuralEngineer": { "type": "string", "description": "Structural engineering partner" },
        "awards": { "type": "array", "description": "Awards and recognitions list" },
        "floorPlanLevels": { "type": "array", "description": "Floor plan levels with room hotspots" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
